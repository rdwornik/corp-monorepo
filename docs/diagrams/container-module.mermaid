%%{init: {
  'theme': 'base',
  'themeVariables': {
    'fontSize': '13px',
    'fontFamily': 'Segoe UI, sans-serif',
    'lineColor': '#718096',
    'primaryTextColor': '#2d3748'
  }
}}%%
flowchart TB
    subgraph L0["Layer 0 — Foundation"]
        schema["schema/<br/>models, taxonomy, config<br/>PipelineConfig, normalize()"]
        cke["extractor/ CKE<br/>extract_from_text(), tier_router<br/>strategies, post_process"]
        ops_base["ops/<br/>OpsDB facade, ContentRegistry<br/>match_file(), 5 repos"]
    end

    %% Column alignment for L0
    schema ~~~ cke ~~~ ops_base

    subgraph L1["Layer 1 — Core Services"]
        config["config.py + vault_io.py<br/>AppConfig, get_config()<br/>write_note(), list_projects()"]
        router["ingest/router.py<br/>detect &rarr; match &rarr; route<br/>&rarr; record &rarr; move &rarr; extract"]
        overnight_base["overnight/ + cleanup/<br/>preflight, cke_client<br/>scanner, proposer"]
        domain_tools["project/ + opportunity/<br/>CPE scan/extract/render<br/>COM new/prep-deck"]
    end

    subgraph L2["Layer 2 — Orchestration"]
        index["index_builder.py<br/>rebuild_index()<br/>update_project()"]
        ops_db["ops/database.py<br/>AssetRepo, EventRepo<br/>RoutingRepo"]
        state_mgmt["task + workflow + resolver<br/>+ template_mgr + overnight/state<br/>execute_workflow()"]
    end

    %% Column alignment for L2
    index ~~~ ops_db ~~~ state_mgmt

    subgraph L3["Layer 3 — Composition"]
        query_retrieve["query_engine + retrieve/<br/>search_facts(), BM25<br/>client prep, RFP context"]
        inbox["ingest/inbox.py<br/>Rich terminal UI<br/>interactive routing"]
        actions_chat["actions/ + chat.py + intent<br/>12 modules, chat_loop()<br/>keywords &rarr; LLM routing"]
        test_pipe["test_pipeline.py<br/>sandbox isolation"]
    end

    cli["cli/ — 18 modules, 40+ commands<br/>Static L1-3, Runtime L9"]

    opsDB[("ops.db<br/>WAL mode")]
    indexDB[("index.db<br/>FTS5")]
    stateDB[("overnight_state.db")]

    %% L1 → L0
    config --> schema
    router --> ops_base
    overnight_base --> cke
    domain_tools --> cke

    %% L2 → L1
    index --> config
    ops_db --> ops_base
    state_mgmt --> config

    %% L3 → L2
    query_retrieve --> index
    inbox --> ops_db
    actions_chat --> state_mgmt
    test_pipe --> router

    %% CLI → L3 (lazy)
    cli -.-> inbox
    cli -.-> actions_chat

    %% DB connections
    ops_base --- opsDB
    index --- indexDB
    state_mgmt --- stateDB

    classDef layer0 fill:#38a169,stroke:#276749,color:#fff
    classDef layer1 fill:#3182ce,stroke:#2b6cb0,color:#fff
    classDef layer2 fill:#805ad5,stroke:#6b46c1,color:#fff
    classDef layer3 fill:#dd6b20,stroke:#c05621,color:#fff
    classDef cliStyle fill:#e53e3e,stroke:#c53030,color:#fff
    classDef db fill:#2d3748,stroke:#1a202c,color:#fff

    class schema,cke,ops_base layer0
    class config,router,overnight_base,domain_tools layer1
    class index,ops_db,state_mgmt layer2
    class query_retrieve,inbox,actions_chat,test_pipe layer3
    class cli cliStyle
    class opsDB,indexDB,stateDB db
