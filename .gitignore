# Python
__pycache__/
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/*
# tracked: hub files.watcherExclude for .claude/worktrees (PLAYBOOK §8)
!.vscode/settings.json
.idea/

# OS
desktop.ini
Thumbs.db

# Environment
.env

# Claude — project `.claude/` is config, tracked by default (tracked-.claude
# convention). Only per-machine / runtime surfaces are ignored: per-machine
# settings, the scheduled-tasks lock, and the parallel-session worktrees dir.
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Native parallel-session worktrees live in-repo here (ADR-61/#107); ignore so they don't
# show as untracked AND so gitignore-respecting walkers (ruff) don't descend into the full
# checkout. pytest is already safe via its default `.*` norecursedirs (dot-dir skip).
.claude/worktrees/

# Data
*.db
_outputs/

# Extraction outputs (data/ is the canonical output root)
data/_outputs/

# Hypothesis
.hypothesis/

# Test output
output/

# docs/staging (working space, never commit)
docs/staging/

# Sandbox (copied source files — never commit)
.sandbox/

# Ephemeral Tier-1 closure output
logs/

# >>> enforcement-mesh (ADR-85 /override) >>>
logs/.session-override-token
logs/OVERRIDES.md
